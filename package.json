  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "franc-min": "^6.2.0",
    "ts-fsrs": "^5.4.1"
  }
}
