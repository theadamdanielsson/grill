{
  "name": "grill",
  "version": "8.8.1",
  "description": "An AI agent for your vault, on desktop and phone. No API key needed, or run it on Claude Code or Codex. It edits notes with undo, turns photos, scans and PDFs into notes, and tests you on what you wrote.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "tsc -p tsconfig.test.json && node test/run.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "esbuild": "0.25.12",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@huggingface/transformers": "3.7.2",
    "d3-force": "^3.0.0",
    "franc-min": "^6.2.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "sharp": "npm:empty-npm-package@1.0.0",
    "onnxruntime-node": "npm:empty-npm-package@1.0.0",
    "moment": "2.31.0"
  }
}
