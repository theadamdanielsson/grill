{
  "name": "grill",
  "version": "8.7.0",
  "description": "An agentic learning system for Obsidian. Grill keeps state on what you know, note by note. Chat, tests and your other agents all work from it.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@types/node": "^22.10.0",
    "esbuild": "0.25.12",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@huggingface/transformers": "3.7.2",
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "franc-min": "^6.2.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "sharp": "npm:empty-npm-package@1.0.0",
    "onnxruntime-node": "npm:empty-npm-package@1.0.0",
    "moment": "2.31.0"
  }
}
